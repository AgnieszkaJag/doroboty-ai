# Optional PostHog browser analytics for production builds.
# Use the public project token, never a personal PostHog API key.
VITE_POSTHOG_PROJECT_TOKEN=

# Match the region configured for the PostHog project.
# Examples: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
